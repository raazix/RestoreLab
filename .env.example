# ==============================================================================
# RestoreLab Environment Configuration
# ==============================================================================

# Restic Engine Configuration
# Path to restic executable. Defaults to 'bin/restic.exe' or 'restic' on PATH.
RESTIC_BINARY_PATH=bin/restic.exe

# Lab Restic Repository Location (Must be within approved lab bounds)
RESTIC_REPOSITORY=./data/lab_repo

# Repository encryption password (Never stored in plaintext in the database)
RESTIC_PASSWORD=restorelab-lab-secret-passphrase-change-in-prod

# Optional Restic cache directory
RESTIC_CACHE_DIR=./data/restic_cache

# Lab Boundary Paths (Safety isolation by default)
LAB_SOURCE_DIR=./data/lab_source
LAB_RESTORE_DIR=./data/lab_restore
LAB_EXPERIMENTS_DIR=./data/lab_experiments

# Persistence
DATABASE_PATH=./data/restorelab.db

# Operational Limits & Safety
LOG_LEVEL=INFO
COMMAND_TIMEOUT_SECONDS=120
MAX_SOURCE_SCAN_MB=500
MAX_MANIFEST_FILES=10000

# Optional Supermemory Extension (Disabled by default, requires explicit user consent)
SUPERMEMORY_ENABLED=false
SUPERMEMORY_API_KEY=
SUPERMEMORY_NAMESPACE=restorelab-incidents
SUPERMEMORY_WORKSPACE_ID=restorelab-incidents
SUPERMEMORY_API_URL=https://api.supermemory.ai
